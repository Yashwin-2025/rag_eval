DATABASE_URL=postgresql://rag:rag@localhost:5432/ragdb

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Embeddings + chat (OpenRouter model ids)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Must match sql/init.sql vector(N); text-embedding-3-small supports truncating to this via
# the OpenAI `dimensions` param (native output is 1536, truncated to 1024 here)
EMBEDDING_DIM=1024

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Chatbot RAG
