DATABASE_URL=postgresql://rag:rag@localhost:5432/ragdb

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Embeddings + chat (OpenRouter model ids)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Must match sql/init.sql vector(N) and your embedding model (1536 for text-embedding-3-small)
EMBEDDING_DIM=1536

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Chatbot RAG

# Must match sql/init.sql (768) and your chosen model output dim
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
